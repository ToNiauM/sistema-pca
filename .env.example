# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SESSION_COOKIE_AGE=28800
AXES_COOLOFF_MINUTES=15
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# Produção atrás de Nginx do host + Cloudflare (config.settings.prod). Em
# dev deixe True/0 (default das settings) — não precisa declarar aqui.
SECURE_SSL_REDIRECT=true
# Conservador em validação (não 31536000/1 ano) — HSTS longo é irreversível
# pelo tempo do max-age; ver comentário em config/settings/prod.py.
SECURE_HSTS_SECONDS=3600

# SQLite — arquivo único, sem serviço de banco (Fase 31). 4 barras = caminho
# absoluto dentro do container (/app/data/db.sqlite3).
DATABASE_URL=sqlite:////app/data/db.sqlite3

# Nome do volume Docker que guarda o arquivo do banco (db.sqlite3 e os
# arquivos -wal/-shm ao lado). É declarado como EXTERNO no compose.yml
# justamente para que `docker compose down -v` não o apague.
#
# Numa instalação nova, crie-o ANTES do primeiro `docker compose up -d`:
#
#     docker volume create pca_data
#
# É o único passo que o modo externo acrescenta ao runbook de portabilidade.
# Em troca, nenhum `down -v` volta a levar o banco junto.
DATA_VOLUME=pca_data

# Backup diário (Cloudflare R2 via rclone). Conta e bucket
# criados deste plano; token escopado só a este bucket.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET=replace-with-bucket-name

# Assistente do PCA (Fase 39) — chat escolhe o provedor via IA_PROVEDOR;
# embeddings sempre OpenAI. IA_API_KEY vazio desabilita
# o assistente inteiro (menu oculto, rotas 404) sem quebrar check/testes/
# collectstatic/robô (A20).
IA_PROVEDOR=openai
IA_API_KEY=
IA_MODELO_ASSISTENTE=gpt-4.1-mini
# Raciocínio do chat. OpenAI: vai como reasoning_effort ("" = não envia).
# Anthropic: "" ou none = thinking desligado (Haiku 4.5/Sonnet 5); low..max =
# effort. Opus 5.5 não aceita none, e o pensamento conta em IA_MAX_TOKENS_RESPOSTA
# (use ~8000 e IA_TIMEOUT_S=60 com ele).
IA_ESFORCO_RACIOCINIO=
# Reservado — leitor IA do robô SEI é fase futura; não ativa nada aqui.
IA_MODELO_ROBO=gpt-4o-mini
IA_ROBO_ATIVO=False
IA_MODELO_EMBED=text-embedding-3-small
# IA_PROVEDOR_EMBED só aceita "openai" (Anthropic não tem API de
# embeddings). IA_API_KEY_EMBED vazia reaproveita IA_API_KEY — só faz
# sentido preenchê-la quando IA_PROVEDOR for diferente de "openai".
IA_PROVEDOR_EMBED=openai
IA_API_KEY_EMBED=
# Padrão: <diretório do banco PCA>/ia/{indice,estado,conversas}.sqlite3.
IA_INDICE_PATH=
IA_ESTADO_PATH=
IA_CONVERSAS_PATH=
IA_MAX_PERGUNTAS_DIA=50
# Limitado por SESSION_COOKIE_AGE — nunca sobrevive além da sessão.
IA_CONVERSA_TTL_S=28800
IA_MAX_TOKENS_RESPOSTA=1500
IA_TIMEOUT_S=30
IA_PRAZO_PERGUNTA_S=60
# store=False desliga o armazenamento de estado da chamada no provedor;
# NÃO é garantia de retenção zero em todas as camadas operacionais (A21).

# O prazo interno de 60 s do assistente (IA_PRAZO_PERGUNTA_S) é a proteção
# principal; o timeout do worker Gunicorn precisa ser maior que ele.
GUNICORN_TIMEOUT=150
