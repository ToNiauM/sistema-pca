# Django
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SESSION_COOKIE_AGE=28800
AXES_COOLOFF_MINUTES=15
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
# Porta publicada do Postgres no host (útil só para acesso externo pontual
# com um cliente SQL; o serviço `web` sempre fala com `db` pela rede interna
# do compose, nunca por esta porta). Sem declarar aqui, o compose usa o
# default 127.0.0.1:15433 — troque só se rodar mais de uma instância deste
# sistema no mesmo host (ex.: uma instância de validação isolada).
# DB_BIND_ADDRESS=127.0.0.1
# DB_PORT=15433
# Produção atrás de Nginx do host + Cloudflare (config.settings.prod). Em
# dev deixe True/0 (default das settings) — não precisa declarar aqui.
SECURE_SSL_REDIRECT=true
# Conservador em validação (não 31536000/1 ano) — HSTS longo é irreversível
# pelo tempo do max-age; ver comentário em config/settings/prod.py.
SECURE_HSTS_SECONDS=3600

# Identidade visual/textos da casca (settings.DSGOV, config/settings/base.py).
# Sem estas variáveis o sistema roda com os defaults neutros abaixo — troque
# pelos dados do órgão que hospeda esta instalação.
# DSGOV_ORGAO=Órgão
# DSGOV_ORGAO_SIGLA=ÓRGÃO
# DSGOV_SISTEMA=Sistema de Acompanhamento do Plano de Contratações Anual
# DSGOV_SISTEMA_SUBTITULO=
# DSGOV_LOGO=
# DSGOV_RODAPE_TEXTO=Sistema de Acompanhamento do Plano de Contratações Anual
# DSGOV_RODAPE_TIMBRADO=

# PostgreSQL
POSTGRES_DB=pca
POSTGRES_USER=pca
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://pca:replace-with-a-database-password@db:5432/pca

# Nome do volume Docker que guarda o banco. É declarado como EXTERNO no
# compose.yml justamente para que `docker compose down -v` não o apague.
#
# Numa instalação nova, crie-o ANTES do primeiro `docker compose up -d`:
#
#     docker volume create pca_pgdata
#
# É o único passo que o modo externo acrescenta ao runbook de portabilidade.
# Em troca, nenhum `down -v` volta a levar o banco junto.
PGDATA_VOLUME=pca_pgdata

# Backup diário (Cloudflare R2 via rclone). Token escopado só a este bucket.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
R2_BUCKET=replace-with-bucket-name
