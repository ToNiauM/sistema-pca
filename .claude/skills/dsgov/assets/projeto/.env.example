# Django
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SESSION_COOKIE_AGE=28800
AXES_COOLOFF_MINUTES=15
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8000
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=3600

# Identidade visual (opcional; o padrão vem de config/settings/base.py)
DSGOV_ORGAO=__ORGAO__
DSGOV_ORGAO_SIGLA=__ORGAO_SIGLA__
DSGOV_SISTEMA=__SISTEMA__
DSGOV_SISTEMA_SUBTITULO=

# Banco. Sem DATABASE_URL o dev usa SQLite (db.sqlite3). Com Docker, use o Postgres abaixo.
POSTGRES_DB=__PROJETO__
POSTGRES_USER=__PROJETO__
POSTGRES_PASSWORD=troque-a-senha-do-banco
DATABASE_URL=postgres://__PROJETO__:troque-a-senha-do-banco@db:5432/__PROJETO__
PGDATA_VOLUME=__PROJETO___pgdata
